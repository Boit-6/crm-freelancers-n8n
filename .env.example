# Variables del entorno de orquestación (n8n). Copiar a `.env` al lado del
# docker-compose.yml — el `.env` real está gitignoreado.
#
#   cp .env.example .env
#
# docker-compose.yml define un default razonable para casi todas: acá sólo hace
# falta completar las que son propias de tu instalación. El puerto 5678 queda
# enlazado a 127.0.0.1: para webhooks externos usá un proxy/túnel HTTPS que
# apunte a localhost:5678; no expongas directamente el editor de n8n.
# La medición E7 usa una cuenta de desarrollador de prueba autenticada. Guardá
# REALTIME_TEST_EMAIL y REALTIME_TEST_PASSWORD en FormularioLeads/.env.local,
# junto con las claves de Supabase; nunca pongas credenciales reales aquí.

# ─── n8n ─────────────────────────────────────────────────────────────────────
# URL pública con la que n8n se anuncia (ngrok o dominio). CON barra final.
N8N_PUBLIC_URL=http://localhost:5678/

# ─── CRM ─────────────────────────────────────────────────────────────────────
# Avisos al desarrollador: id del workflow workflow/avisos.json una vez
# importado en n8n (se ve en la URL del editor). Todos los puntos de aviso del
# flujo principal y el de tickets lo llaman.
AVISOS_WORKFLOW_ID=

# Bot de Telegram (opcional): los desarrolladores lo vinculan desde el panel.
# Secreto que Telegram manda en cada llamada al webhook del bot; se le pasa a
# setWebhook como secret_token (ver workflow/telegram_vincular.json).
TELEGRAM_WEBHOOK_SECRET=

# Nombre de la plataforma. Los correos salen de su casilla como
# "<nombre del espacio> vía <PLATAFORMA_NOMBRE>", con Reply-To al desarrollador.
PLATAFORMA_NOMBRE=FormularioLeads

# Demo de portfolio (ver docs/despliegue-demo.md). Con un correo en
# DEMO_EMAIL_SINK, todos los correos de n8n van a esa casilla. N8N_PROXY_HOPS=1
# cuando n8n está detrás de un proxy HTTPS (Caddy).
DEMO_EMAIL_SINK=
N8N_PROXY_HOPS=0

# Chat de Telegram al que llegan los avisos (el del bot, no el del usuario).
TELEGRAM_CHAT_ID=

# URLs. Ninguna vive escrita a mano dentro de los nodos del workflow.
# FRONTEND_URL es la base de los enlaces que viajan en los mails (propuesta,
# aceptación, calificación). N8N_PUBLIC_URL (arriba) es la base del enlace de pago.
FRONTEND_URL=http://localhost:3000
GOTENBERG_URL=http://gotenberg:3000/forms/chromium/convert/html
# Orígenes del navegador para RENDERIZAR copias importables de workflow/*.json:
# `node --env-file=.env scripts/render-workflows.mjs --out ./rendered-workflow`.
# n8n 2.34.6 NO evalúa $env en allowedOrigins: cambiar esta variable o reiniciar
# el contenedor no cambia CORS; hay que renderizar e importar/activar la copia.
CORS_ORIGINS=http://localhost:3000,https://formulario-leads-psi.vercel.app

# Días que vale el enlace de aceptación desde que se envía la propuesta.
# Vencido, el enlace deja de aceptar/rechazar/modificar (se revalida en la base).
TOKEN_VIGENCIA_DIAS=14

# ─── Idempotencia (deudas S5 y S6 de la Tabla 11) ────────────────────────────
# Ventana de deduplicación de la captación: dentro de estos minutos, un segundo
# envío del formulario con el MISMO correo no crea otro lead ni dispara otra
# propuesta. El INSERT del lead es condicional, así que la garantía no depende
# del navegador; el bloqueo del botón evita además el viaje de ida.
DEDUP_VENTANA_MINUTOS=10
# Minutos que se le dan a la cadena de aceptación para terminar antes de que el
# proceso de reconciliación considere que un lead en ACEPTADO quedó sin factura.
# Demasiado bajo, el cron pisaría una aceptación todavía en curso.
RECONCILIACION_GRACIA_MINUTOS=15
# Días de vigencia de la factura que emite la reconciliación (los mismos que
# aplica la rama de aceptación normal).
FACTURA_VENCIMIENTO_DIAS=15

# ─── Propuestas pendientes y transiciones de facturas (01-sep-2026) ──────────
# Horas que puede esperar un lead HOT/WARM en NUEVO sin que el profesional le
# fije precio/plazo/alcance antes de que "🔔 Cron - Propuestas Pendientes"
# empiece a insistir por Telegram (mitiga el riesgo declarado en §4.3.1 y §4.9:
# hasta ahora sólo había un aviso puntual al calificar el lead). Es un
# recordatorio, no dispara la propuesta ni toca `estado`.
PROPUESTA_PENDIENTE_HORAS_UMBRAL=24
# Días de atraso, contados desde `fecha_vencimiento`, que tolera una factura
# PENDIENTE antes de que "🟠 Cron - Recordatorios Pago 10AM" la pase a VENCIDA
# (cierra la deuda de §4.8 y del punto 7 del Capítulo 8: el enum lo preveía y
# ningún nodo lo escribía). El indicador "Facturas vencidas" de la Tabla 8
# (`metrics_mensuales.facturas_vencidas`) cuenta este estado, no una fecha.
FACTURA_VENCIDA_DIAS_GRACIA=7

# ─── Cobro con Stripe Connect (RAMA 8) ────────────────────────────────────────
# Clave secreta de la cuenta de Stripe de la PLATAFORMA, con Connect activado
# (Dashboard → Developers → API keys; sk_test_... en modo de prueba). Cada
# desarrollador conecta su propia cuenta Express desde "Tu espacio": lo que
# pagan sus clientes va a esa cuenta y la plataforma se queda con la comisión.
# Vacía = el enlace de la factura cae al modo de desarrollo (pago simulado).
STRIPE_SECRET_KEY=
# Secreto de firma del webhook (Dashboard → Developers → Webhooks → el endpoint
# <N8N_PUBLIC_URL>webhook/stripe, con el evento checkout.session.completed).
# Obligatorio: sin él, el nodo rechaza todo evento.
STRIPE_WEBHOOK_SECRET=
# Base de la API. Vacía = https://api.stripe.com. Se cambia sólo para apuntar a
# un doble de prueba local (tests/stripe-doble.mjs).
STRIPE_API_BASE=
# Porcentaje de cada factura que se queda la plataforma. Stripe lo separa solo
# (application fee) al cobrar.
COMISION_PLATAFORMA_PORCENTAJE=1

# ─── Calificación de leads (Tabla 4 de la tesis) ─────────────────────────────
# Los defaults reproducen exactamente la tabla documentada; están acá para poder
# recalibrar el criterio de calificación sin tocar el workflow.
# `tests/scoring.mjs` verifica que los defaults no cambien el resultado.
SCORING_UMBRAL_HOT=70
SCORING_UMBRAL_WARM=40
SCORING_PRESUPUESTO=5000:40,2000:30,1000:20,300:10
SCORING_URGENCIA=alta:30,media:15,baja:5
SCORING_SERVICIO=desarrollo_web:20,ecommerce:20,app_movil:18,automatizacion:18,marketing:15,seo:15,diseno_ui:15,consultoria:12,soporte:5
SCORING_BONUS_TELEFONO=5
SCORING_BONUS_DESCRIPCION=5

# ─── Validación funcional (tests/escenarios.mjs) ─────────────────────────────
# Sólo hacen falta para correr la suite de escenarios de punta a punta.
N8N_BASE=http://localhost:5678
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Header auth de los webhooks del panel interno. El mismo par nombre/valor que
# se carga en la credencial de n8n «CRM - Header Auth (panel)» y en el
# .env.local del front.
CRM_PANEL_HEADER=x-crm-token
CRM_PANEL_TOKEN=

# ─── Tickets (tabla `tickets` + workflow/tickets.json) ───────────────────────
# El tablero vive en la base (Supabase): se crean y mueven desde el dashboard.
# La escala (estados, prioridades, días de tolerancia y pesos del score) está
# en db/schema.sql: enums ticket_estado / ticket_prioridad y las funciones
# ticket_dias_escalada / ticket_peso.

# Chat de Telegram del resumen diario del cron; vacío = usa TELEGRAM_CHAT_ID.
TICKETS_TELEGRAM_CHAT_ID=

# Al aceptarse una propuesta se siembran estos tickets del proyecto.
# Filas "Titulo|PRIORIDAD|dias_hasta_vencer" separadas por ";".
# {cliente} y {servicio} se reemplazan con los datos del lead.
TICKETS_PLANTILLA_PROYECTO=Kickoff con {cliente}|ALTA|2;Primera entrega de {servicio}|MEDIA|7;Revision y ajustes|MEDIA|14;Cobrar la factura de {cliente}|ALTA|10

# Dirección de contacto que se ofrece en las pantallas de enlace vencido,
# ya usado o inválido de la página de aceptación. Si queda vacía, esas
# pantallas no invitan a escribir (antes lo hacían sin dar ninguna dirección).
NEXT_PUBLIC_EMAIL_CONTACTO=
# Usuario del bot de Telegram de la plataforma, sin @ (opcional). Con él, el
# panel ofrece un enlace directo para vincular los avisos.
NEXT_PUBLIC_TELEGRAM_BOT=
# Comisión de la plataforma que se le muestra al desarrollador en "Tu espacio".
# Tiene que coincidir con COMISION_PLATAFORMA_PORCENTAJE de n8n.
NEXT_PUBLIC_COMISION_PORCENTAJE=1
# Modo demo de portfolio: con NEXT_PUBLIC_DEMO=1 se muestra el aviso de demo y
# el login ofrece entrar con estas cuentas (sus claves son públicas a propósito).
NEXT_PUBLIC_DEMO=
NEXT_PUBLIC_DEMO_DESARROLLADOR_EMAIL=
NEXT_PUBLIC_DEMO_DESARROLLADOR_CLAVE=
NEXT_PUBLIC_DEMO_CLIENTE_EMAIL=
NEXT_PUBLIC_DEMO_CLIENTE_CLAVE=
