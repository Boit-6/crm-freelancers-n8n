# Dependencias / build (por si quedan en la raíz)
node_modules/
.next/
out/
rendered-workflow/

# Husky regenera este helper interno con el hook "prepare" en cada npm install
.husky/_/

# Variables de entorno y secretos — NUNCA al repo
.env
.env.local
.env*.local
# Copias de respaldo del .env: `.env` sola no las cubre y el 28-ago-2026 una de
# ellas se coló en un commit (se retiró antes de pushear).
.env.bak-*
.env.*.bak
*.env.bak

# Datos persistentes de n8n (docker compose)
n8n_data/

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Copias de respaldo de los flujos exportados de n8n. No son el artefacto: si
# entran al repo, cualquier herramienta que lea workflow/*.json termina midiendo
# o probando código viejo.
workflow/*.backup-*.json

# Reportes que generan las pruebas contra el sistema levantado
reportes/

# Estado local de la CLI de Supabase
supabase/.temp/
supabase/.branches/
