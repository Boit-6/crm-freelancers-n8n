# Dependencias / build (por si quedan en la raíz)
node_modules/
.next/
out/
rendered-workflow/

# Husky regenera este helper interno con el hook "prepare" en cada npm install
.husky/_/

# Variables de entorno y secretos — NUNCA al repo
.env
.env.local
.env*.local
# Copias de respaldo del .env: `.env` sola no las cubre y el 28-ago-2026 una de
# ellas se coló en un commit (se retiró antes de pushear).
.env.bak-*
.env.*.bak
*.env.bak

# Datos persistentes de n8n (docker compose)
n8n_data/

# Sistema operativo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Basura de Word (backups automáticos y lock files del .docx)
*.docx.bak-*
~$*.docx

# Copias de respaldo de los flujos exportados de n8n. No son el artefacto: si
# entran al repo, cualquier herramienta que lea workflow/*.json termina midiendo
# o probando código viejo.
workflow/*.backup-*.json

# Material de trabajo interno que la tesis no cita. El §4.1 remite a este repo,
# así que lo que queda versionado debería ser el artefacto y su evidencia, no las
# notas de preparación de la defensa ni las capturas que quedaron obsoletas.
# Ambas carpetas siguen existiendo en disco: se sacan del repo, no se borran.
docs/_interno/
docs/_historico/
