{
  "name": "formularioleads-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,css,md}": [
      "prettier --write"
    ]
  },
  "comentarioOverrides": "eslint-plugin-react-hooks@7 importa 'zod-validation-error/v4', que sólo existe en la v4, pero declara aceptar ^3.5.0; eslint-plugin-react-compiler la fija en ^3.0.3 y npm resolvía a la 3.5.4, con lo que eslint no arrancaba (ERR_PACKAGE_PATH_NOT_EXPORTED).",
  "overrides": {
    "zod-validation-error": "^4.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "4.1.16",
    "next": "^16.3.8",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "4.1.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@next/eslint-plugin-next": "^16.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-react-compiler": "19.0.0-beta-e1e972c-20250221",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "4.1.11"
  }
}
