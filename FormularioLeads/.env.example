# Copiar a `.env.local` (gitignoreado) y completar.

# Base de los webhooks de n8n, para las llamadas desde el navegador.
# Local:      http://localhost:5678
# Navegador remoto: URL HTTPS accesible mediante proxy/túnel; el compose sólo
# publica 127.0.0.1:5678. N8N_PUBLIC_URL por sí sola no abre ese puerto.
NEXT_PUBLIC_N8N_BASE=http://localhost:5678

# Base de n8n para las llamadas server-side del proxy /api/crm/[accion].
# Opcional: si no está, se usa NEXT_PUBLIC_N8N_BASE. Sirve para apuntar al n8n
# por su red interna sin exponer esa URL al navegador. /api/tickets usa sesión
# del desarrollador y RLS del espacio; no llama a n8n ni usa TICKETS_API_KEY.
# N8N_BASE=http://localhost:5678

# Supabase — Project URL (Settings → API → Project URL). No es secreta.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# anon / publishable key (Settings → API → anon public). No es secreta: es la
# que usa el front bajo sesión, y RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Credencial de los webhooks del panel interno (cancelar pedido, resolver
# pedidos de cambio, mover el estado del trabajo). Esas acciones ya no se llaman
# directo desde el navegador: pasan por /api/crm/*, que exige la sesión del
# desarrollador y comprueba que la acción sea sobre su espacio antes de
# agregar este header del lado del servidor. El par nombre/valor tiene que
# coincidir con la credencial «CRM - Header Auth (panel)» de n8n.
CRM_PANEL_HEADER=x-crm-token
CRM_PANEL_TOKEN=

# Sólo para el medidor E7 local: service_role crea y elimina un lead ficticio
# del espacio de la cuenta de prueba. La aplicación NO usa esta clave; el
# dashboard lee con la anon key y sesión. No ponerla en NEXT_PUBLIC_* ni
# ejecutar el medidor en producción sin planificar el dato de prueba.
# SUPABASE_SERVICE_ROLE_KEY=
# Cuenta de prueba de tipo desarrollador, con espacio propio legible. El
# medidor se suscribe como ella; no mide con anon sin sesión. No versionar
# credenciales reales. Son necesarias junto con la clave anterior para E7.
# REALTIME_TEST_EMAIL=desarrollador-prueba@example.test
# REALTIME_TEST_PASSWORD=REEMPLAZAR_LOCALMENTE

# Dirección de contacto que se ofrece en las pantallas de enlace vencido,
# ya usado o inválido de la página de aceptación. Si queda vacía, esas
# pantallas no invitan a escribir (antes lo hacían sin dar ninguna dirección).
NEXT_PUBLIC_EMAIL_CONTACTO=
# Usuario del bot de Telegram de la plataforma, sin @ (opcional). Con él, el
# panel ofrece un enlace directo para vincular los avisos.
NEXT_PUBLIC_TELEGRAM_BOT=
# Comisión de la plataforma que se le muestra al desarrollador en "Tu espacio".
# Tiene que coincidir con COMISION_PLATAFORMA_PORCENTAJE de n8n.
NEXT_PUBLIC_COMISION_PORCENTAJE=1

# Modo demo de portfolio (ver docs/despliegue-demo.md). Con NEXT_PUBLIC_DEMO=1
# se muestra el aviso de demo en todas las páginas y el login ofrece entrar con
# estas cuentas. Sus claves son públicas a propósito: un cron las restaura.
NEXT_PUBLIC_DEMO=
NEXT_PUBLIC_DEMO_DESARROLLADOR_EMAIL=
NEXT_PUBLIC_DEMO_DESARROLLADOR_CLAVE=
NEXT_PUBLIC_DEMO_CLIENTE_EMAIL=
NEXT_PUBLIC_DEMO_CLIENTE_CLAVE=
